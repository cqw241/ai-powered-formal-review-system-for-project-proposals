# Copy to repo root `.env` for local development. Do not commit real secrets.

# --- App ---
# SQLite database path (relative to repo root, or absolute).
# Ordinary startup does not wipe this file.
DATABASE_URL=sqlite:///./backend/data/app.db

# Directory for uploaded PDF materials (files named by material id).
MATERIALS_DIR=./backend/data/materials

# Directory for uploaded policy PDFs (files named by policy id).
POLICIES_DIR=./backend/data/policies

# Max upload size in bytes (default 20MB).
UPLOAD_MAX_BYTES=20971520

# Backend CORS origins for the Vite dev server.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Cloud multimodal API (server-side only; never expose as VITE_*) ---
# OpenAI-compatible base URL, e.g. DashScope:
#   https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=

# Model ID that accepts image input + structured JSON output.
# Example (DashScope): qwen3.8-27b  or  qwen3-vl-plus
LLM_MODEL=

# API key stays on the server. Leave empty to run project CRUD without model calls.
LLM_API_KEY=

# Request timeout in seconds for model calls.
LLM_TIMEOUT_SECONDS=60
